# Python
.venv/
__pycache__/
*.py[cod]

# Node
node_modules/

# Generated benchmark output stays local by default.
# Force-add curated result artifacts only when docs/run-log.md calls for them.
results/*
!results/.gitkeep

# Local generated registry database and static site.
registry/*.sqlite
registry/*.sqlite-shm
registry/*.sqlite-wal
registry/site/
site/

# Local benchmark metadata can contain machine-local paths and host details.
metadata/*.json

# Local environment
.env
.DS_Store
